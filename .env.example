# --- Local laptop (default) ---
# Ollama + FastEmbed. Set LOCAL_DEV_MODE=false for cloud (Render / Compose api).
LOCAL_DEV_MODE=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMS=384
QDRANT_COLLECTION_LOCAL=crag_chunks_local

# --- Cloud (Render + Qdrant Cloud) — set these on the Render service ---
# LOCAL_DEV_MODE=false
# QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=crag_chunks
# CHECKPOINT_PATH=/data/checkpoints.sqlite
# CORS_ORIGINS=https://YOUR-APP.vercel.app
# EXPOSE_DEVELOPER_ERRORS=false

GEMINI_API_KEY=
GROQ_API_KEY=
ROUTEWAY_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crag_chunks
CHECKPOINT_PATH=data/checkpoints.sqlite
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=agentic-crag
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPOSE_DEVELOPER_ERRORS=true

# Free-tier models only (default). Routeway IDs must end with :free.
FREE_MODELS_ONLY=true
LLM_TIER=free
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
ROUTEWAY_MODEL=deepseek-v4.1-flash:free
LLM_REQUEST_TIMEOUT_S=45

# Frontend (Vercel env or frontend/.env.local):
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com
# NEXT_PUBLIC_SHOW_DEV_ERRORS=true
