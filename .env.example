# Local dev (Ollama + local embed). Set LOCAL_DEV_MODE=false for cloud gateway + Gemini embed.
LOCAL_DEV_MODE=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMS=384
QDRANT_COLLECTION_LOCAL=crag_chunks_local

GEMINI_API_KEY=
GROQ_API_KEY=
ROUTEWAY_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crag_chunks
CHECKPOINT_PATH=data/checkpoints.sqlite
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=agentic-crag
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPOSE_DEVELOPER_ERRORS=true

# Free-tier models only (default). Routeway IDs must end with :free.
FREE_MODELS_ONLY=true
LLM_TIER=free
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
ROUTEWAY_MODEL=deepseek-v4.1-flash:free
# ROUTEWAY_BASE_URL=https://api.routeway.ai/v1
# EMBED_MODEL=gemini-embedding-001
# GEMINI_RPM=8
# GEMINI_RPD=200
# GROQ_RPM=20
# GROQ_RPD=800
# ROUTEWAY_RPM=5
# ROUTEWAY_RPD=200
# EMBED_RPM=8
# TAVILY_RPM=15
# CHAT_PER_IP_RPM=6
LLM_REQUEST_TIMEOUT_S=45

# Frontend (frontend/.env.local): NEXT_PUBLIC_SHOW_DEV_ERRORS=true
